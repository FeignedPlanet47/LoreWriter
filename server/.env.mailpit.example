# Use this file only for local Mailpit testing.
# Copy these SMTP values into .env, then start with:
# docker compose -f docker-compose.yml -f docker-compose.mailpit.yml up --build
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@novelforge.local
SMTP_FROM_NAME=NovelForge
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
