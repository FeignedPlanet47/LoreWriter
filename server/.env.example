POSTGRES_DB=novelforge
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_SECRET=replace_this_with_at_least_64_random_characters_before_starting_the_api_1234567890
JWT_ISSUER=novelforge-api
JWT_AUDIENCE=novelforge-android
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Separate secret for HMAC hashes of 6-digit email verification codes.
# Generate with: openssl rand -hex 32
EMAIL_CODE_SECRET=replace_with_a_separate_random_email_code_secret_1234567890
EMAIL_VERIFICATION_CODE_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5

# REAL EMAIL DELIVERY (STARTTLS example, works with Gmail and many SMTP providers).
# Never commit the real password to Git. Put it only in server/.env.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-account@gmail.com
#   SMTP_PASSWORD=your-16-character-google-app-password
#   SMTP_FROM_EMAIL=your-account@gmail.com
#
# For another provider, replace HOST/PORT/USERNAME/PASSWORD with its SMTP values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=replace_with_smtp_app_password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=NovelForge
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

ENVIRONMENT=development
API_DOMAIN=api.example.com
